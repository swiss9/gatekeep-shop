# ---- Server ----
PORT=8080
NODE_ENV=development

# ---- Supabase ----
# Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=super-long-random-string

# ---- Telegram ----
# From @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AA...
# Your personal Telegram user id, from @userinfobot. Always forced to
# superadmin on login — the owner escape hatch.
ADMIN_TELEGRAM_ID=123456789
# Bot username, no @.
TELEGRAM_BOT_USERNAME=YourBotUsername
# The short name you chose in BotFather /newapp. Leave as 'store' unless
# you registered a different one.
TELEGRAM_APP_SHORT_NAME=store

# ---- URLs ----
# Deployed client URL. Locks CORS in production.
CLIENT_ORIGIN=https://your-store.vercel.app
# Public Mini App URL. Shown on web_app buttons in bot messages.
MINI_APP_URL=https://your-store.vercel.app
# Public URL of this server. Used to proxy Supabase Storage so images
# and downloads work even on ISPs that block *.supabase.co.
PUBLIC_SERVER_URL=https://your-service.onrender.com

# ---- Stripe (optional) ----
# From Stripe Dashboard → Developers → API keys → Secret key.
STRIPE_SECRET_KEY=sk_live_...
# From Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
